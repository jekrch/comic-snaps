{
  "name": "comic-snaps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun build src/sw.ts --outdir public --target browser && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:py": "pytest scripts/tests -q",
    "test:types": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@jekrch/react-viewport-lightbox": "^0.9.1",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^0.575.0",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6",
    "@vitest/coverage-v8": "^5.0.0",
    "aubiojs": "^0.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8",
    "vitest": "^5.0.0"
  }
}
