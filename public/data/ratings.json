    "series:final-cut": {
      "label": "Final Cut",
      "avg": 6.5,
      "count": 1,
      "ratings": [
        {
          "uid": "141a6d566b9c",
          "user": null,
          "attributed": false,
          "score": 6.5,
          "review": "The art is fantastic. I love Burns' style, his storyboarding, colors; it's great, inspiring work. The story he tells here starts strong for me; I love squirrely characters with confusing motivations. But I thought it failed to go anywhere interesting. I wasn't looking for some kind of dramatic conclusion, I just wanted one last weird take on our hero, and what I got felt a bit hallow.",
